# Copy to .env.local for local development.
# The dev environment (scripts/start.sh) exports the same default.
DATABASE_URL=postgres://ukarts:ukarts@localhost:5432/ukarts

# Secret used to sign session cookies. Set a long random value in production
# (e.g. on Vercel). A dev fallback is used when unset.
AUTH_SECRET=dev-ukarts-secret-change-me
